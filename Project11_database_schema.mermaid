erDiagram
    KLANT ||--o{ LOCATIE : heeft
    LOCATIE ||--o{ TANKINSTALLATIE : bevat
    LOCATIE ||--o{ OPDRACHT : krijgt
    OPDRACHT ||--o{ OPDRACHT_ACTIVITEIT : bestaat_uit
    ACTIVITEIT ||--o{ OPDRACHT_ACTIVITEIT : "wordt uitgevoerd in"
    CERTIFICAAT ||--o{ ACTIVITEIT : "vereist voor"
    INSPECTEUR ||--o{ INSPECTEUR_CERTIFICAAT : bezit
    CERTIFICAAT ||--o{ INSPECTEUR_CERTIFICAAT : "hoort bij"
    GEBRUIKER ||--o| INSPECTEUR : "is (bij rol inspecteur)"
    INSPECTEUR ||--o{ ROUTE : rijdt
    ROUTE ||--o{ ROUTESTOP : bestaat_uit
    OPDRACHT ||--o| ROUTESTOP : "ingepland als"
    GEBRUIKER ||--o{ WIJZIGINGSLOG : "heeft gewijzigd"
    GEBRUIKER ||--o{ NOTIFICATIE : ontvangt
    OPDRACHT ||--o{ NOTIFICATIE : "gaat over"

    KLANT {
        int id PK
        string bedrijfsnaam "bijv Shell, BP, Total"
        string contactpersoon
        string email
        string telefoon
    }
    LOCATIE {
        int id PK
        int klant_id FK
        string naam "naam tankstation"
        string adres
        string postcode
        string plaats
        string regio
        decimal latitude
        decimal longitude
        time open_van "navragen"
        time open_tot "navragen"
        string toegangsinstructies
    }
    TANKINSTALLATIE {
        int id PK
        int locatie_id FK
        string product "diesel, benzine, Euro 98"
        string soort "ondergronds of bovengronds"
        int inhoud_liter
        date laatste_keuring
        date volgende_keuring_uiterlijk
    }
    ACTIVITEIT {
        int id PK
        string naam "werkzaamheid, lijst volgt van Marijn"
        int standaard_duur_min "vaste tijd per type"
        int vereist_certificaat_id FK
    }
    OPDRACHT {
        int id PK
        int locatie_id FK
        string status "open, ingepland, uitgevoerd, geannuleerd"
        date plan_maand "maandblok van de klant"
        date deadline "opgelegd door de klant"
        datetime tijdvenster_start "navragen"
        datetime tijdvenster_eind "navragen"
        int prioriteit
        int geschatte_duur_min "som activiteiten, afhankelijk van aantal tanks"
        string opmerkingen
    }
    OPDRACHT_ACTIVITEIT {
        int opdracht_id FK
        int activiteit_id FK
    }
    GEBRUIKER {
        int id PK
        string naam
        string email
        string wachtwoord_hash
        string rol "planner, bedrijfsleider, technisch_manager, administratie, inspecteur, beheerder"
    }
    INSPECTEUR {
        int id PK
        int gebruiker_id FK
        string naam
        string telefoon
        string startadres "navragen: kantoor of thuis"
        decimal start_lat
        decimal start_lng
        time werktijd_start "navragen"
        time werktijd_eind "navragen"
        bool actief
    }
    CERTIFICAAT {
        int id PK
        string naam
    }
    INSPECTEUR_CERTIFICAAT {
        int inspecteur_id FK
        int certificaat_id FK
        date geldig_tot
    }
    ROUTE {
        int id PK
        int inspecteur_id FK
        date datum
        decimal totale_km
        int totale_rijtijd_min
        string status "voorstel, goedgekeurd, afgewezen"
    }
    ROUTESTOP {
        int id PK
        int route_id FK
        int opdracht_id FK
        int volgorde
        datetime geplande_aankomst
        datetime gepland_vertrek
        datetime werkelijke_aankomst
        datetime werkelijk_vertrek
    }
    WIJZIGINGSLOG {
        int id PK
        int gebruiker_id FK
        string tabel "bijv route, opdracht"
        int record_id
        string wijziging
        datetime tijdstip
    }
    NOTIFICATIE {
        int id PK
        int gebruiker_id FK "planner en bedrijfsleider"
        int opdracht_id FK
        string bericht "deadline verloopt bijna"
        bool gelezen
        datetime aangemaakt_op
    }
